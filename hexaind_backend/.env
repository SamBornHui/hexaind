# Password for the 'elastic' user (at least 6 characters)
ELASTIC_USERNAME=elastic
ELASTIC_PASSWORD=databrick

# Port to expose Elasticsearch HTTP API to the host
ES_URL=http://es:9200
ELASTIC_HOSTS=http://es:9200

# HEXAIND3 Database Name
HEXAIND3_DATABASE_NAME=Hexaind

# Container Environments, These are static for every client
HEXAIND_DATA=/Users/muhammadumersohailkhan/Desktop/Projects/HEXAIND/hexaind-data
HEXAIND_HOME=/Users/muhammadumersohailkhan/Desktop/Projects/HEXAIND/hexaind-home
HEXAIND_DRIVE=/Users/muhammadumersohailkhan/Desktop/Projects/HEXAIND/hexaind-drive

# Host paths, these can be changed cliet to clent 
HEXAIND_SOURCE=/mount-drive
HEXAIND_DESTINATION=/hexaind-data

TEST_BE_API=https://localhost:8081

# CELERY
RABBITMQ_DEFAULT_USER=user
RABBITMQ_DEFAULT_PASS=password
REDIS_DEFAULT_PASS=Databrick2024
#CELERY_RESULT_BACKEND_URL=redis://:${REDIS_DEFAULT_PASS}@localhost:6379/0
CELERY_RESULT_BACKEND_URL=redis://@localhost:6379
# CELERY_BROKER_URL=amqp://${RABBITMQ_DEFAULT_USER}:${RABBITMQ_DEFAULT_PASS}@localhost:5672//
CELERY_BROKER_URL=amqp://${RABBITMQ_DEFAULT_USER}:${RABBITMQ_DEFAULT_PASS}@localhost:5672//

# worker auto-scaling (we don't want to spin workers with max concurrency, since these workers are consuming lot of memoery)
# This is suggesting run minimum 1 worker process, If required scale it up 3 child workers(processes)
CELERY_WORKER_AUTOSCALE='1,4'

HEXAIND_FRONT_END_URL=http://localhost:4200
FORM_LOGIN_ALLOWED=True
SSO_LOGIN_ALLOWED=True
SHOW_ALL_AD_USERS=False

#AIRFLOW
AIRFLOW_PROJ_DIR=./airflow
#'${id -u}'
# change this to 50000 for podman based deployment
AIRFLOW_UID=1000
# cat /etc/group | grep docker    ## check this value for every instance and add it in ~/.bashrc
AIRFLOW_GROUP_ID=990
AIRFLOW_USERNAME='airflow'
AIRFLOW_PASSWORD='airflow'
AIRFLOW_URL='http://airflow-webserver:8080'

#Rescale job status time interval
RESCALE_URI='https://platform.rescale.com/api/v2'
RESCALE_STATUS_INTERVAL=300

#To Create Default Server Admin User
SERVER_ADMIN_EMAIL_TO_CREATE_IF_NO_SERVER_ADMIN=databrickadmin@databrick.tech
#The below one Automatically becomes True if FORM_LOGIN_ALLOWED=False, becomes True if SSO_LOGIN_ALLOWED=False
SERVER_ADMIN_IS_SSO_USER=False
SERVER_ADMIN_PASSWORD=sOMEcRiTicaLpASSwORD

FIRST_NAME=Databrick
LAST_NAME=Admin

#ML Flow URI
MLFLOW_TRACKING_URI=http://127.0.0.1:5000

# GATEWAY
GATEWAY_URI=http://localhost:8070
GATEWAY_SUPERSET_URL=http://localhost:8088

# HEXAIND_DATA_JUPYTERHUB_WORK_DIR is used inside container this is constant.do not change this

HEXAIND_DATA_JUPYTERHUB_WORK_DIR=${HEXAIND_DATA}/jupyterhub
HOST_JUPYTERHUB_WORK_DIR=${HEXAIND_DESTINATION}/jupyterhub

# THERMOCALC
# devops to change THERMOCALC_DESTINATION to proper path before deploying along with env variables VM_INTERNAL_IP,MONGO_EXPOSED_PORT
THERMOCALC_HOME=/thermocalc_home
THERMOCALC_DESTINATION=/thermocalc_home
THERMOCALC_BATCH_LIMIT=1
THERMOCALC_HOST=kswnnawplicap01.novelis.biz
THERMOCALC_PATH=/apps/Thermo-Calc/Thermo-Calc/2023b/,/apps/Thermocalc/Thermo-Calc/2023b/
## we have to change actual value of prod instance
THERMOCALC_WHL_PATH=/dummy_whl_path
IS_STANDALONE_DEPLOYMENT=False
## replace with thermocalc host ip address
THERMO_CALC_SERVICE_URL=localhost:8083
MAX_POLLING_COUNT_FOR_TC_STATUS=100
SECONDS_TO_SLEEP_FOR_TC_STATUS=10
THERMOCALC_WHL_PATH=/dummy_whl_path
THERMOCALC_WHL_FILE=NONE

CLIENT_FLAG="P"

#image analytics socket
IMAGE_PROGRESS_SOCKET=ws://0.0.0.0:8000/v1/image_analysis/image_progress_socket
IMAGE_BATCH_PROCESSING_SOCKET=ws://0.0.0.0:8000/v1/image_analysis/image_batch_processing_socket

## Rescale socket
RESCALE_SOCKET_URL=ws://workflow_apis:8000/v1/assets/rescale_status

#true if want to aggregate
AGGREGATE_ML_CONTAINERS=true

# Change this for micron instances only
TDAM_SHARED_PATH=${HEXAIND_DATA}

## External App Ports used by Jupyter containers
EXTERNAL_APP_PORT_START=10000
EXTERNAL_APP_PORT_END=10200

##GCP CREDS PATH FOR MICRON
EXTERNAL_GOOGLE_CREDS_PATH=/home/gcloud/creds.json
GOOGLE_APPLICATION_CREDENTIALS=${HEXAIND_DATA}/gcloud/application_default_credentials.json

# Use azure (default, for azure key vault), gcp (for google cloud secret manager), local (for local devlopment)
CLOUD_PROVIDER=azure

