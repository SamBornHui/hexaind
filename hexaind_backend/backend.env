HEXAIND_DATA=${HEXAIND_DATA:-/hexaind-data}
HEXAIND_HOME=${HEXAIND_HOME:-/hexaind-home}
HEXAIND_DRIVE=${HEXAIND_DRIVE:-/hexaind-drive}
HEXAIND_DESTINATION=${HEXAIND_DESTINATION:-/hexaind-data}

HEXAIND3_DATABASE_NAME=${HEXAIND3_DATABASE_NAME:-Hexaind}
IS_STANDALONE_DEPLOYMENT=${IS_STANDALONE_DEPLOYMENT:-False}

HEXAIND_FRONT_END_URL=${HEXAIND_FRONT_END_URL:-http://localhost:4200}
FORM_LOGIN_ALLOWED=${FORM_LOGIN_ALLOWED:-True}
SSO_LOGIN_ALLOWED=${SSO_LOGIN_ALLOWED:-True}
SHOW_ALL_AD_USERS=${SHOW_ALL_AD_USERS:-False}

SERVER_ADMIN_EMAIL_TO_CREATE_IF_NO_SERVER_ADMIN=${SERVER_ADMIN_EMAIL_TO_CREATE_IF_NO_SERVER_ADMIN:-databrickadmin@databrick.tech}
SERVER_ADMIN_IS_SSO_USER=${SERVER_ADMIN_IS_SSO_USER:-False}
SERVER_ADMIN_PASSWORD=${SERVER_ADMIN_PASSWORD:-sOMEcRiTicaLpASSwORD}

FIRST_NAME=${FIRST_NAME:-Databrick}
LAST_NAME=${LAST_NAME:-Admin}

TEST_BE_API=${TEST_BE_API:-http://localhost:8081}

# airflow
AIRFLOW_PROJ_DIR=${AIRFLOW_PROJ_DIR:-./airflow}
AIRFLOW_UID=${AIRFLOW_UID:-1000}
AIRFLOW_GROUP_ID=${AIRFLOW_GROUP_ID:-990}
AIRFLOW_USERNAME=${AIRFLOW_USERNAME:-airflow}
AIRFLOW_PASSWORD=${AIRFLOW_PASSWORD:-airflow}
AIRFLOW_URL=${AIRFLOW_URL:-http://airflow-webserver:8080}

# rescale
RESCALE_URI=${RESCALE_URI:-https://platform.rescale.com/api/v2}
RESCALE_STATUS_INTERVAL=${RESCALE_STATUS_INTERVAL:-300}
RESCALE_SOCKET_URL=${RESCALE_SOCKET_URL:-ws://workflow_apis:8000/v1/assets/rescale_status}

CLIENT_FLAG=${CLIENT_FLAG:-P}

#image analytics socket
IMAGE_PROGRESS_SOCKET=${IMAGE_PROGRESS_SOCKET:-ws://0.0.0.0:8000/v1/image_analysis/image_progress_socket}
IMAGE_BATCH_PROCESSING_SOCKET=${IMAGE_BATCH_PROCESSING_SOCKET:-ws://0.0.0.0:8000/v1/image_analysis/image_batch_processing_socket}

#true if want to aggregate
AGGREGATE_ML_CONTAINERS=${AGGREGATE_ML_CONTAINERS:-false}
TDAM_SHARED_PATH=${TDAM_SHARED_PATH:-/hexaind-data}

## External App Ports used by Jupyter containers
EXTERNAL_APP_PORT_START=${EXTERNAL_APP_PORT_START:-10000}
EXTERNAL_APP_PORT_END=${EXTERNAL_APP_PORT_END:-10200}

##GCP CREDS PATH FOR MICRON
EXTERNAL_GOOGLE_CREDS_PATH=${EXTERNAL_GOOGLE_CREDS_PATH:-/home/gcloud/creds.json}
GOOGLE_APPLICATION_CREDENTIALS=${GOOGLE_APPLICATION_CREDENTIALS:-/hexaind-data/gcloud/application_default_credentials.json}

# MLFLOW
MLFLOW_TRACKING_URI=${MLFLOW_TRACKING_URI:-http://localhost:5000}

# GATEWAY
GATEWAY_URI=${GATEWAY_URI:-http://localhost:8070}
GATEWAY_SUPERSET_URL=${GATEWAY_SUPERSET_URL:-http://superset:8088}